{
  "name": "teetimeturrets",
  "version": "0.0.1",
  "description": "Open-source browser arcade golf-combat game (Three.js + Rapier + Vite).",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
