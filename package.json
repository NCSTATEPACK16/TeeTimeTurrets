{
  "name": "teetimeturrets",
  "version": "0.0.1",
  "description": "Open-source browser arcade golf-combat game (Three.js + Rapier + Vite).",
  "main": "index.js",
  "scripts": {
    "postinstall": "puppeteer browsers install chrome",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/buildDrive.mjs && node tools/sizeBudget.mjs",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "gate": "vite build -c tools/gate.vite.config.ts && node tools/sceneGate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build && node tools/smoke.mjs",
    "probe": "vite build -c tools/probe.vite.config.ts && node tools/.probe-out/turretProbe.mjs",
    "probe:terrain": "vite build -c tools/terrainProbe.vite.config.ts && node tools/.terrain-out/terrainProbe.mjs",
    "plan": "vite build -c tools/holePlan.vite.config.ts && node tools/.plan-out/holePlan.mjs",
    "plan:course": "vite build -c tools/coursePlan.vite.config.ts && node tools/.course-out/coursePlan.mjs",
    "plan:png": "node tools/planPng.mjs --scale=2",
    "swatches": "node tools/readSwatches.mjs",
    "pack:ground": "node tools/textures/packGround.mjs"
  },
  "keywords": [
    "golf",
    "three.js",
    "rapier",
    "webgl",
    "game"
  ],
  "author": "",
  "license": "Apache-2.0 AND AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@capacitor/core": "8.6.3",
    "@capacitor/ios": "8.6.3",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@types/three": "^0.185.4",
    "@xmldom/xmldom": "^0.9.12",
    "puppeteer": "^25.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
