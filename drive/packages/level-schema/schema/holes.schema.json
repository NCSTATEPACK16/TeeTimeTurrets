{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gcs:level-packet/holes.schema.json",
  "title": "GolfCartSimulator level packet v0.2: holes.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["holes"],
  "properties": {
    "holes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "par", "tee", "green", "pin"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 36 },
          "par": { "type": "integer", "minimum": 3, "maximum": 6 },
          "tee": { "$ref": "#/$defs/point" },
          "green": { "$ref": "#/$defs/point" },
          "pin": { "$ref": "#/$defs/point" }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": { "x": { "type": "number" }, "z": { "type": "number" } }
    }
  }
}
